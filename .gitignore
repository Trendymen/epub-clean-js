# Dependencies
node_modules/

# macOS
.DS_Store

# Logs
*.log

# Test temp / build artifacts
/tmp/
*.bak

# 临时调试/审计脚本（一次性，硬编码绝对路径，不入库）
scripts/tmp-*.mjs

# 程序产物（项目根 output/，含 translated/healed/clean 子目录）
output/

# Python archive caches (虽然只保留 .py，但防止 pip install 后 __pycache__ 进 git)
archive/scripts-py/__pycache__/
archive/scripts-py/*.pyc
archive/scripts-py/.pytest_cache/
archive/scripts-py/.venv/

# IDE
.vscode/
.idea/
*.swp

# 字体源资产（大体积二进制，本地构建输入，不入 git；子集化产物随 EPUB 输出）
books/source-han-serif-sc/
books/source-han-sans-sc/
